# Database connection, e.g. mysql+aiomysql://user:password@127.0.0.1:3306/lab_agent
DATABASE_URL=

# JWT authentication
SECRET_KEY=replace_with_a_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Redis connection
REDIS_URL=

# 大模型配置
LLM_API_KEY=你的API_KEY
LLM_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash

# 模型参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120000
LLM_MAX_RETRIES=2
